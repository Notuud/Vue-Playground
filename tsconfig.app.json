{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  // Include the environment types and all source files. The extra `*.vue`
  // pattern ensures Vue SFCs are included for type-checking in some editors.
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // `composite` enables project references / incremental builds. Keep it
    // if you plan to use `tsc --build` workflows.
    "composite": true,
    // Store build info in a tmp folder to avoid polluting the repo root.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // If you enable incremental builds, TS will create a `.tsbuildinfo` file
    // which speeds up subsequent type-checks.
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
